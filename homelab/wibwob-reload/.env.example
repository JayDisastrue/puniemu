POSTGRES_PASSWORD=change-me
SERVER_NAME=WibWob Homelab
# Optional: Gmail address + app password for the in-game account link/restore codes
EMAIL_FOR_AUTH=
EMAIL_APP_PASSWORD=
# Listen only on this address. On a rented/dedicated server, set it to the
# Tailscale IP (tailscale ip -4) so port 80 isn't open to the internet.
BIND_ADDRESS=0.0.0.0
# In-game admin commands (Settings > serial code box). Pick a number only you know.
ADMIN_PIN=
