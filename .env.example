# Copy to .env and fill in.
# Must be 16 characters or fewer so homelab/tools/patch_client.py can fit it into the game client.
PUNI_DOMAIN=puni.example.xyz
POSTGRES_PASSWORD=change-me
# Cloudflare API token with Zone:DNS:Edit on the domain's zone.
CF_API_TOKEN=
# Comma-separated list is accepted, e.g. 4.0.6,4.0.7,4.0.8
GAME_VERSION=4.0.6
SERVER_NAME=puniemu
# Optional: Gmail address + app password for the in-game account link/restore codes.
EMAIL_FOR_AUTH=
EMAIL_APP_PASSWORD=
# How often changed accounts are saved (seconds). At most this much play is lost on a crash or power cut.
SAVE_INTERVAL_SECONDS=10
